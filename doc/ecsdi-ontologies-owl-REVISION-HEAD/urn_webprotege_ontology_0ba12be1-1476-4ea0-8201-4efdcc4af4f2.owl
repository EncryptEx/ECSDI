        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa el mensaje enviado por parte del valorador al cliente conteniendo productos que pueden ser de su interés</rdfs:comment>
        <rdfs:label>EnvioSugerenciaProductoACliente</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RqqBU8hpgtxCVjPK9ySxOL -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RqqBU8hpgtxCVjPK9ySxOL">
