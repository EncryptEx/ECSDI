    <!-- http://webprotege.stanford.edu/R7TpcJifPNZoaw6vJm6nUzO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7TpcJifPNZoaw6vJm6nUzO">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la contraoferta enviada por el centro logístico a un transportista solicitando un precio más bajo para el envío.</rdfs:comment>
        <rdfs:label>PeticionContraOfertaLote</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7UPqHZMRr1aO2d8axkFteu -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7UPqHZMRr1aO2d8axkFteu">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clase que representa un producto, extendido con su puntuación otorgada por valoraciones</rdfs:comment>
        <rdfs:label>ValoracionProducto</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R7g9uR0TQZ16WcgG0n8v5o -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R7g9uR0TQZ16WcgG0n8v5o">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición mandada por el agente Catalogo al agente Tesorero para añadir o actualizar los datos bancarios de un proveedor</rdfs:comment>
        <rdfs:label>PeticionAñadirProveedor</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R88x11efoYKfu0tAk1epmV -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R88x11efoYKfu0tAk1epmV">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la acción mandada al cliente para pedirle valoración sobre un producto ya comprado.</rdfs:comment>
        <rdfs:label>PeticiónFeedbackCliente</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8IYfAv5WR1EMExpUgA4U29 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8IYfAv5WR1EMExpUgA4U29">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa el mensaje enviado por parte del tesorero al agente de ventas comunicándole que una compra ha sido efectuada y que hay que guardar la compra com realizada.</rdfs:comment>
        <rdfs:label>PeticionGuardarCompraRealizada</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8IdxU0ev6GUu8ofQETwaXO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8IdxU0ev6GUu8ofQETwaXO">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la acción mandada al cliente por parte del agente tesorero que contiene los datos del envio</rdfs:comment>
        <rdfs:label>EnvioDatosEnvio</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8KCrM7ZMuSnKzTeHlPwCyH -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8KCrM7ZMuSnKzTeHlPwCyH">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa el presupuesto para el envío de un lote enviado por un transportista al agente logístico</rdfs:comment>
        <rdfs:label>RespuestaSolicitudPresupuesto</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8KOHzGaRHG8e6w8nxUgIFn -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8KOHzGaRHG8e6w8nxUgIFn">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la acción mandada por parte del tesorero a la entidad bancaria solicitando la tranferencia entre dos entidades.</rdfs:comment>
        <rdfs:label>PeticiónBancariaDeTransferencia</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8PAVppKmHrbSn3Zbqr05Jc -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8PAVppKmHrbSn3Zbqr05Jc">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la la respuesta (Factura) del agente Ventas para el Actor cliente - (Acción Enviar la factura)</rdfs:comment>
        <rdfs:label>ResultadoCompra</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R8jLVuHiLktpMSwwvqHEb2 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8jLVuHiLktpMSwwvqHEb2">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa una dirección de entrega, o de un centro logistico para poder informar al transportista.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dirección</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9DlX2gxfws6EXd3lhAPPi3 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9DlX2gxfws6EXd3lhAPPi3">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición mandada por el agente Ventas hacia un centro logistico para asignar una cantidad de un producto comprado en los lotes pendientes de envio</rdfs:comment>
        <rdfs:label>PeticionAsignarLoteProducto</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9E7nYbv1uOW1zGiw3tiuoO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9E7nYbv1uOW1zGiw3tiuoO">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa una linea (articulo comprado, cantidad, precio) de una comanda</rdfs:comment>
        <rdfs:label>LineaComanda</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9PXcbDQHYHK3qi1IL2u1Pp -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9PXcbDQHYHK3qi1IL2u1Pp">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la confirmación enviada por parte de la entidad bancaria al tesorero de una transferencia solicitada anteriormente.</rdfs:comment>
        <rdfs:label>RespuestaBancariaTransferencia</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9mHhCp1gsqH2kraq2MTv3W -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9mHhCp1gsqH2kraq2MTv3W">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición enviada por el agente logístico a un transportista para aceptar la oferta de un envío de lote.</rdfs:comment>
        <rdfs:label>PeticionAceptarOfertaLote</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/R9yArL3N9CE7xasPkJmDZxP -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9yArL3N9CE7xasPkJmDZxP">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Comunicacion</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBSokswjsgZ91kWRx7ABmJ1 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBSokswjsgZ91kWRx7ABmJ1">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representa una de las características asociadas a un producto, como información descriptiva o propiedades relevantes para su clasificación y búsqueda.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caracteristica producto</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBUZQgdsU4ADf8y15NL2J1N -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBUZQgdsU4ADf8y15NL2J1N">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la respuesta a la contraoferta por parte de un transportista al agente logístico</rdfs:comment>
        <rdfs:label>RespuestaContraOferta</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBzHsQC9SjDDzLTJN7mC2iC -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBzHsQC9SjDDzLTJN7mC2iC">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representa al usuario comprador del sistema. Puede realizar compras, recibir recomendaciones y generar valoraciones sobre productos.</rdfs:comment>
        <rdfs:label>Cliente</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9yArL3N9CE7xasPkJmDZxP"/>
        <rdfs:label>Respuesta</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCDeqpwWtqHMmT6tAzFjcXF -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCDeqpwWtqHMmT6tAzFjcXF">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa una compra efectuada por un cliente</rdfs:comment>
        <rdfs:label>Compra</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCMvA7uiZ4iNyCvgC0Wdojf -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCMvA7uiZ4iNyCvgC0Wdojf">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que represnta el feedback enviado por parte del cliente al agente valorador puntuando un producto que ha comprado (comentario opcional)</rdfs:comment>
        <rdfs:label>RespuestaFeedbackCliente</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RCcJuCdwENHgEUsPFGcr8x5 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RCcJuCdwENHgEUsPFGcr8x5">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición mandada por el agente Ventas al actor Empresa Venedora para delegar el envio de uno de sus productos</rdfs:comment>
        <rdfs:label>PeticionNuevaVentaExterna</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDDkeDS0u32HNkxaqg1zmAW -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDDkeDS0u32HNkxaqg1zmAW">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición de compra mandada por el agente asistente del usuario al agente vendedor - Percepción de Ventas (Cliente realiza compra)</rdfs:comment>
        <rdfs:label>PeticionCompra</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R9yArL3N9CE7xasPkJmDZxP"/>
        <rdfs:label>Acción</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDOLzXcgzIYrfXwCMyIxTjx -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDOLzXcgzIYrfXwCMyIxTjx">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RCDANbVpZZ6pALCfEamuD0h"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la respuesta mandada por el agente Ventas al Actor Empresa Venedora que informa de la resolucion de su solicitud</rdfs:comment>
        <rdfs:label>RespuestaNuevoProducto</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDslZy31Vjfc3PxnTYUj3xR -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDslZy31Vjfc3PxnTYUj3xR">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición mandada por el agente Ventas al Tesorero para guardar los datos de facturacion de un Cliente</rdfs:comment>
        <rdfs:label>PeticionGuardarDatosFacturacionClientes</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDsxjYfHfvAWhub6HKa9Qzx -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RDsxjYfHfvAWhub6HKa9Qzx">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIueWTBADRnJBP8eXj1Mhy"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la petición mandada por el actor Empresa Venedora a Catalogo para que añada un producto (datos de producto y datos del proveedor)</rdfs:comment>
        <rdfs:label>PeticionNuevoProducto</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RDtarB7OuPVdesFKgUDpreE -->

