        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa la factura respuesta del sistema al cliente cuando este efectua una compra.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FacturaCompra</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RHz5d0DRrCGzH7UpZb3pIZ -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RHz5d0DRrCGzH7UpZb3pIZ">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase que representa el IBAN de una entidad, o el del propio sistema, con el fin de poder cobrarles o pagarles</rdfs:comment>
        <rdfs:label>IBAN</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RbS3chrRbIyVt8RIO0PqOO -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RbS3chrRbIyVt8RIO0PqOO">
