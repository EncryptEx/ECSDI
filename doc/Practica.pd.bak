																			<object type="Goal" id="125">
																			    <base type="Entity">
																				<field name="name">Devolución de productos</field>
																				<field name="description">Recibir peticion, computar si es aplicable y procesar en caso satisfactorio la devolución de un producto.</field>
																				<field name="uniqueId">503</field>
																			    </base>

																			    <field name="subGoals"><list>
																				<object type="Goal" id="126">
																				    <base type="Entity">
																					<field name="name">Procesar petición</field>
																					<field name="description">Con los datos recibidos, se comprueba que si la causa de devolución es la no-satisfacción del cliente, esta devolución sólo podrá ser efectuada si han pasado cómo máximo quinze días desde la recepción del paquete por parte del cliente.</field>
																					<field name="uniqueId">534</field>
																				    </base>

																				    <field name="scope">:optional</field>
																				</object>

																				<object type="Goal" id="127">
